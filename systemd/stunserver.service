[Unit]
Description=STUN Server - Session Traversal Utilities for NAT
Documentation=https://github.com/zhouhailin/stunserver
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=stunserver
Group=stunserver
ExecStart=/opt/stunserver/bin/stunserver --config /opt/stunserver/etc/stunserver.conf
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stunserver

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stunserver/log
PrivateTmp=true

# Resource limits
LimitNOFILE=1048576

# Kernel UDP buffer limits are applied through
# /etc/sysctl.d/99-stunserver.conf (installed by deploy/Makefile). Restart the
# service after changing them so the listening socket is recreated with the
# new [network] buffer sizes.

[Install]
WantedBy=multi-user.target
