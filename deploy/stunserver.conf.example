# STUN Server Configuration File
# Location: /opt/stunserver/etc/stunserver.conf
# Format: TOML

[server]
# 监听地址（IP 或主机名）
listen_address = "0.0.0.0"

# STUN 服务端口（UDP 和 TCP）
port = 3478

# 工作线程数（0 = 自动检测 CPU 核心数）
worker_threads = 0

# 最大并发连接数
max_connections = 10000

[logging]
# 日志级别：trace, debug, info, warn, error
level = "info"

# 日志目录
log_dir = "/opt/stunserver/log"

# 日志文件名前缀
file_prefix = "stunserver"

# 单个日志文件最大大小（MB）
max_file_size_mb = 100

# 日志保留天数
retention_days = 30

# 是否启用控制台输出
enable_console = true

# 轮转后的日志文件是否 gzip 压缩（生成 .gz 文件）
compress_rotated_logs = true

[network]
# UDP 接收缓冲区大小（字节）
udp_recv_buffer_size = 1048576

# UDP 发送缓冲区大小（字节）
udp_send_buffer_size = 1048576

# TCP 连接超时（秒）
tcp_connection_timeout_sec = 30

# TCP 空闲超时（秒）
tcp_idle_timeout_sec = 300

[security]
# 是否启用 TLS（未来扩展）
enable_tls = false

# TLS 证书路径（未来扩展）
# tls_cert_path = "/opt/stunserver/etc/cert.pem"

# TLS 私钥路径（未来扩展）
# tls_key_path = "/opt/stunserver/etc/key.pem"
